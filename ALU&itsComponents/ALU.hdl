/* 1. zx: if (zx == 1) sets x = 0
    For this i can use a mux and the a will be input and b will be 0 and sel will the zx input. Therefore if 
    zx is 1 then the output will always be 0.

2. zy: if (zy == 1) sets y = 0      
    The same as zx will be done here using mux16
 
i think this is zeroing it not for the output but for the operation inside the ALU. and i think that the 
f function is 0 or 1, 0 means add and 1 means & and i dont know what & means. But i think whatever the result 
is after f funciton that will be the output.

yeah whatever, i just did it. I did not see any videos or helps. I just made it. And yeah the twos complement thing
i infered and knew what to do.

*/

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?  ##
        nx, // negate the x input? ##
        zy, // zero the y input?  ##
        ny, // negate the y input? ##
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    Mux16(a=x , b=false , sel=zx , out=zerox );
    Mux16(a=y , b=false , sel=zy , out=zeroy );
    Not16(in=zerox , out=notzerox );
    Not16(in=zeroy , out=notzeroy );
    Mux16(a= zerox , b=notzerox , sel=nx , out=negx );
    Mux16(a= zeroy , b= notzeroy , sel=ny , out=negy );
    And16(a=negx , b=negy , out=xandy );
    Add16(a = negx , b = negy, out =xplusy );
    Mux16(a=  xandy, b= xplusy , sel=f , out=posout );
    Not16(in=posout , out=negout );
    Mux16(a=posout , b=negout , sel=no , out=out );
}

